Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.carrentchiangmai\.com$ [NC]
RewriteRule ^ https://carrentchiangmai.com%{REQUEST_URI} [R=301,L]
Redirect 410 /readme.txt
Redirect 410 /index-.html
Redirect 410 /index.html.moved
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Frame-Options "SAMEORIGIN"
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/(assets|img|fonts)/#"
</IfModule>
ErrorDocument 404 /404.html
